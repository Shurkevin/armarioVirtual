# Copia este archivo como .env y añade tu clave. Nunca uses EXPO_PUBLIC_ para secretos.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo estable alternativo para el análisis de outfits. Déjalo vacío para desactivar el fallback.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
PORT=3001
# Orígenes web permitidos, separados por comas. Déjalo vacío para clientes nativos.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
REQUEST_TIMEOUT_MS=120000

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# En un móvil físico, sustituye la IP por la IP local de tu Mac.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
